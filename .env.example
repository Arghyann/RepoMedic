# Ollama model. gemma4:e4b runs on a normal laptop; gemma4:26b (MoE, 4B active) is the quality pick;
# gemma4:31b-cloud runs on Ollama's cloud if your laptop is weak. gemma3:4b works with REPOMEDIC_TOOL_MODE=json.
REPOMEDIC_MODEL=gemma4:e4b
OLLAMA_HOST=http://localhost:11434
# auto = Gemma native function calling with automatic fallback; json = grammar-constrained JSON actions
REPOMEDIC_TOOL_MODE=auto
# 1 = enable Gemma thinking mode (slower, shows reasoning in the timeline)
REPOMEDIC_THINK=0
# 8192 fits a 16 GB laptop; raise it if you have RAM/VRAM to spare
REPOMEDIC_NUM_CTX=8192
# Override the detected test command for the target repo, e.g. "npm test" or "poetry run pytest -q"
# REPOMEDIC_TEST_CMD=
